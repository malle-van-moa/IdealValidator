# IdeaValidator - Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development # development, test, production

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Firebase Configuration (wähle Firebase ODER Supabase)
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# ODER Supabase Configuration
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # Nur für Server-seitige Operationen

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4 # oder gpt-4-turbo, gpt-3.5-turbo-16k, etc.
OPENAI_MAX_TOKENS=4000

# Export Services
# PDF Service (z.B. für Puppeteer)
PDF_SERVICE_USERNAME=your-pdf-service-username
PDF_SERVICE_PASSWORD=your-pdf-service-password

# Notion API (für Notion Export)
NOTION_API_KEY=your-notion-api-key
NOTION_TEMPLATE_ID=your-template-page-id

# E-Mail Service (SendGrid, Mailgun, etc.)
EMAIL_SERVICE=sendgrid # sendgrid, mailgun, smtp
EMAIL_API_KEY=your-email-service-api-key
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=IdeaValidator

# Nur für SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_SECURE=false # true für SSL

# JWT für Authentifizierung
JWT_SECRET=your-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 Minuten
RATE_LIMIT_MAX=100 # 100 Anfragen pro 15 Minuten

# Logging
LOG_LEVEL=info # debug, info, warn, error

# Analytics (optional)
GOOGLE_ANALYTICS_ID=your-ga-id
MIXPANEL_TOKEN=your-mixpanel-token 