# Allgemeine Einstellungen
NODE_ENV=development
PORT=3000
DEBUG=false
LOG_LEVEL=info

# Datenbank-Typ: "firebase" oder "supabase"
DATABASE_TYPE=firebase

# Firebase-Konfiguration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@firebase.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Private Key...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Supabase-Konfiguration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-key

# API-Keys für externe Dienste
OPENAI_API_KEY=your-openai-api-key
NOTION_API_KEY=your-notion-api-key
SENDGRID_API_KEY=your-sendgrid-api-key

# CORS-Einstellungen
CORS_ORIGIN=http://localhost:3000

# JWT-Konfiguration
JWT_SECRET=your-secure-jwt-secret
JWT_EXPIRES_IN=1d

# Frontend-URL für Weiterleitungen und E-Mail-Links
FRONTEND_URL=http://localhost:3000

# E-Mail-Konfiguration
EMAIL_FROM=noreply@example.com
EMAIL_SENDER_NAME=IdeaValidator

# PDF-Export-Einstellungen
PDF_TEMPLATE_PATH=./templates/report-template.hbs

# Notion-Export-Einstellungen
NOTION_TEMPLATE_ID=your-notion-template-id

# Temp-Verzeichnis für Dateien
TEMP_DIR=./tmp 